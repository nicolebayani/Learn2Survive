<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Splash Screen -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="android.bignerdranch.learn2survive.ui.splash.SplashActivity"
        tools:layout="@layout/activity_splash">
        <action
            android:id="@+id/action_splash_to_onboarding"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeActivity"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Onboarding -->
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="android.bignerdranch.learn2survive.ui.onboarding.OnboardingActivity"
        tools:layout="@layout/activity_onboarding">
        <action
            android:id="@+id/action_onboarding_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_onboarding_to_register"
            app:destination="@id/registerFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Login -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="android.bignerdranch.learn2survive.ui.auth.LoginActivity"
        tools:layout="@layout/activity_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_forgot_password"
            app:destination="@id/forgotPasswordFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeActivity"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Register -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="android.bignerdranch.learn2survive.ui.auth.RegisterActivity"
        tools:layout="@layout/activity_register">
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeActivity"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Forgot Password -->
    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="android.bignerdranch.learn2survive.ui.auth.ForgotPasswordActivity"
        tools:layout="@layout/activity_forgot_password">
        <action
            android:id="@+id/action_forgot_password_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/forgotPasswordFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Home Activity (contains Bottom Navigation) -->
    <activity
        android:id="@+id/homeActivity"
        android:name="android.bignerdranch.learn2survive.ui.home.HomeActivity"
        tools:layout="@layout/activity_home">
        <action
            android:id="@+id/action_home_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeActivity"
            app:popUpToInclusive="true" />
    </activity>

    <!-- Profile (nested in Home) -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="android.bignerdranch.learn2survive.ui.profile.ProfileActivity"
        tools:layout="@layout/activity_profile" />

    <!-- Settings (nested in Home) -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="android.bignerdranch.learn2survive.ui.settings.SettingsActivity"
        tools:layout="@layout/activity_settings" />

</navigation>
