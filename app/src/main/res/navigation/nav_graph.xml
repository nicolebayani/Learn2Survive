<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeActivity">

    <!-- Home Activity (Main entry point with Bottom Navigation) -->
    <activity
        android:id="@+id/homeActivity"
        android:name="android.bignerdranch.learn2survive.ui.home.HomeActivity"
        tools:layout="@layout/activity_home">
        <action
            android:id="@+id/action_home_to_login"
            app:destination="@id/loginActivity"
            app:popUpTo="@id/homeActivity"
            app:popUpToInclusive="true" />
    </activity>

    <!-- Immersive Scenario Activity -->
    <activity
        android:id="@+id/immersiveScenarioActivity"
        android:name="android.bignerdranch.learn2survive.ui.simulation.ImmersiveScenarioActivity"
        tools:layout="@layout/activity_immersive_scenario" />

    <!-- Learning Activity -->
    <activity
        android:id="@+id/learningActivity"
        android:name="android.bignerdranch.learn2survive.ui.learning.LearningActivity"
        tools:layout="@layout/activity_learning" />

    <!-- Games List Activity -->
    <activity
        android:id="@+id/gamesListActivity"
        android:name="android.bignerdranch.learn2survive.ui.games.GamesListActivity"
        tools:layout="@layout/activity_games_list" />

    <!-- Simulations List Activity -->
    <activity
        android:id="@+id/simulationsListActivity"
        android:name="android.bignerdranch.learn2survive.ui.simulation.SimulationsListActivity"
        tools:layout="@layout/activity_simulations_list" />

    <!-- Login Activity -->
    <activity
        android:id="@+id/loginActivity"
        android:name="android.bignerdranch.learn2survive.ui.auth.LoginActivity"
        tools:layout="@layout/activity_login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeActivity"
            app:popUpTo="@id/loginActivity"
            app:popUpToInclusive="true" />
    </activity>

    <!-- Register Activity -->
    <activity
        android:id="@+id/registerActivity"
        android:name="android.bignerdranch.learn2survive.ui.auth.RegisterActivity"
        tools:layout="@layout/activity_register">
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginActivity"
            app:popUpTo="@id/registerActivity"
            app:popUpToInclusive="true" />
    </activity>

    <!-- Forgot Password Activity -->
    <activity
        android:id="@+id/forgotPasswordActivity"
        android:name="android.bignerdranch.learn2survive.ui.auth.ForgotPasswordActivity"
        tools:layout="@layout/activity_forgot_password">
        <action
            android:id="@+id/action_forgot_password_to_login"
            app:destination="@id/loginActivity"
            app:popUpTo="@id/forgotPasswordActivity"
            app:popUpToInclusive="true" />
    </activity>

    <!-- Onboarding Activity -->
    <activity
        android:id="@+id/onboardingActivity"
        android:name="android.bignerdranch.learn2survive.ui.onboarding.OnboardingActivity"
        tools:layout="@layout/activity_onboarding">
        <action
            android:id="@+id/action_onboarding_to_login"
            app:destination="@id/loginActivity"
            app:popUpTo="@id/onboardingActivity"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_onboarding_to_register"
            app:destination="@id/registerActivity"
            app:popUpTo="@id/onboardingActivity"
            app:popUpToInclusive="true" />
    </activity>

</navigation>
