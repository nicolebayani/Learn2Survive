<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Learn2Survive" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_light</item>
        
        <!-- Accent color. -->
        <item name="colorAccent">@color/accent</item>
        
        <!-- Background colors. -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        
        <!-- Text colors. -->
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="android:textColorHint">@color/text_hint_dark</item>
        
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background_dark</item>
        
        <!-- Window background. -->
        <item name="android:windowBackground">@color/background_dark</item>
        
        <!-- Enable edge-to-edge display. -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>
    
    <!-- Glassmorphism Card Style for Dark Mode -->
    <style name="GlassCard">
        <item name="cardBackgroundColor">@color/glass_dark</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/glass_border_dark</item>
        <item name="strokeWidth">1dp</item>
    </style>
    
    <!-- Glassmorphism Button Style for Dark Mode -->
    <style name="GlassButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/glass_dark</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/glass_border_dark</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary_dark</item>
    </style>
</resources>